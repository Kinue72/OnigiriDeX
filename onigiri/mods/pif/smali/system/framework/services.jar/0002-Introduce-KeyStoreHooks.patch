From: Onigiri
Subject: [PATCH] Initialize the VBMeta metadata hook after Android 15 system services

diff --git a/smali/com/android/server/SystemServer.smali b/smali/com/android/server/SystemServer.smali
--- a/smali/com/android/server/SystemServer.smali
+++ b/smali/com/android/server/SystemServer.smali
@@ -2825,6 +2825,8 @@
 
     invoke-virtual {p0, v1}, Lcom/android/server/SystemServer;->startOtherServices(Lcom/android/server/utils/TimingsTraceAndSlog;)V
 
+    invoke-static {}, Lio/mesalabs/onigiri/KeyStoreHooks$VBMetaFixer;->init()V
+
     invoke-virtual {p0, v1}, Lcom/android/server/SystemServer;->startApexServices(Lcom/android/server/utils/TimingsTraceAndSlog;)V
 
     const-string v0, "UpdateWatchdogTimeout"
