+++ b/smali/com/android/server/media/MediaSessionService$SessionManagerImpl.smali
@@ -1488,6 +1488,16 @@
 
     move-result v15
 
+    # Onigiri: ignore the play and pause keys a Bluetooth device sends by itself after it connects.
+    invoke-static {v15, v11}, Lcom/android/server/media/OnigiriBtAutoplayGuard;->blocks(ILandroid/view/KeyEvent;)Z
+
+    move-result v4
+
+    if-eqz v4, :onigiri_dispatch
+
+    return-void
+
+    :onigiri_dispatch
     invoke-static {}, Landroid/os/Binder;->clearCallingIdentity()J
 
     move-result-wide v16
diff --git a/smali/com/android/server/media/MediaSessionService.smali b/smali/com/android/server/media/MediaSessionService.smali
index 13fe1c5..5c9676f 100644
--- a/smali/com/android/server/media/MediaSessionService.smali
