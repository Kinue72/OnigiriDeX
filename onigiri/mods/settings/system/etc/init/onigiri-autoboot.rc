# Charger mode cannot load /data/property; mirror the saved choice after normal boot, then let
# the hook keep the misc cookie that skips the unlocked-bootloader warning. system.prop sets the
# property, so this runs on every boot.
on property:ro.persistent_properties.ready=true && property:persist.sys.onigiri.autoboot=*
    mkdir /cache/onigiri 0700 root root
    write /cache/onigiri/autoboot ${persist.sys.onigiri.autoboot}
    chmod 0600 /cache/onigiri/autoboot
    restorecon_recursive /cache/onigiri
    start onigiri-autoboot

# Samsung starts this class after mounting /cache in init.sec-charger.rc. lpm gets no
# dac_override, so root still needs a group that may enter /cache (system in charger mode).
service onigiri-autoboot /system/bin/sh /system/bin/onigiri-autoboot.sh
    class sec-charger
    user root
    group root system cache
    seclabel u:r:lpm:s0
    oneshot

on property:sys.boot_from_charger_mode=1
    stop onigiri-autoboot
