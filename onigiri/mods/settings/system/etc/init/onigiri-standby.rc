# Car standby daemon. It needs root and broad framework access (airplane mode, sensors,
# deviceidle, CPU hotplug, USB power), so it runs in KernelSU's unconfined ksu domain. The
# Onigiri kernel ships KernelSU, whose runtime policy lets init enter ksu from any file.
service onigiri-standby /system/bin/sh /system/bin/onigiri-standby.sh
    user root
    group root
    seclabel u:r:ksu:s0
    disabled
    oneshot

# Opt-in (Settings > Onigiri Software); the script exits by itself once switched off again.
on property:sys.boot_completed=1 && property:persist.sys.onigiri.car_standby=true
    start onigiri-standby
