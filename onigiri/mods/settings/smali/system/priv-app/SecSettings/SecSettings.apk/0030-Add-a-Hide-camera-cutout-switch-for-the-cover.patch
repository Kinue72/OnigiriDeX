+    :try_end
+    .catch Ljava/lang/RuntimeException; {:try_start .. :try_end} :failed
+    const/4 p0, 0x1
+    return p0
+    :failed
+    move-exception p0
+    const-string p1, "Onigiri"
+    const-string v0, "Cannot change the cover camera cutout"
+    invoke-static {p1, v0, p0}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)I
+    const/4 p0, 0x0
+    return p0
+.end method
