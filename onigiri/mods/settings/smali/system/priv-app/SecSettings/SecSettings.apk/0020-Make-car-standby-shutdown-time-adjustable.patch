From: Onigiri
Subject: [PATCH] Make car standby shutdown time adjustable

diff --git a/res/values/arrays.xml b/res/values/arrays.xml
index 82aadbb..4cf2421 100644
--- a/res/values/arrays.xml
+++ b/res/values/arrays.xml
@@ -3639,4 +3639,24 @@
         <item>2</item>
         <item>3</item>
     </string-array>
+    <string-array name="onigiri_car_standby_hours_entries">
+        <item>1 hour</item>
+        <item>2 hours</item>
+        <item>4 hours</item>
+        <item>8 hours</item>
+        <item>12 hours</item>
+        <item>1 day</item>
+        <item>2 days</item>
+        <item>4 days</item>
+    </string-array>
+    <string-array name="onigiri_car_standby_hours_values">
+        <item>1</item>
+        <item>2</item>
+        <item>4</item>
+        <item>8</item>
+        <item>12</item>
+        <item>24</item>
+        <item>48</item>
+        <item>96</item>
+    </string-array>
 </resources>
diff --git a/res/values/strings.xml b/res/values/strings.xml
index e9de264..c781530 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -15407,6 +15407,7 @@ In Camera, you can use the Top button to take pictures."</string>
     <string name="onigiri_dex_zone_bottom_right">Bottom right zone</string>
     <string name="onigiri_autoboot_title">Power on when power connected</string>
     <string name="onigiri_car_standby_title">Car standby when power is lost</string>
-    <string name="onigiri_car_standby_summary">Airplane mode, sensors off, apps closed and no power to the monitor while unplugged. Shuts down after 4 days or below 10%.</string>
+    <string name="onigiri_car_standby_summary">Airplane mode, sensors off, apps closed and no power to the monitor while unplugged. Shuts down below 10% or after the time below.</string>
+    <string name="onigiri_car_standby_hours_title">Shut down after</string>
     <string name="onigiri_settings_category_title">Onigiri settings</string>
 </resources>
diff --git a/res/xml/onigiri_settings.xml b/res/xml/onigiri_settings.xml
index 5408e82..3c36c3f 100644
--- a/res/xml/onigiri_settings.xml
+++ b/res/xml/onigiri_settings.xml
@@ -10,6 +10,7 @@
         <SecSwitchPreference android:title="@string/onigiri_sleep_when_folded_title" android:key="onigiri_sleep_when_folded" settings:controller="moe.foss.onigiri.settings.SleepOnFoldPreferenceController" />
         <SecSwitchPreference android:title="@string/onigiri_autoboot_title" android:key="onigiri_autoboot" settings:controller="moe.foss.onigiri.settings.AutobootPreferenceController" />
         <SecSwitchPreference android:title="@string/onigiri_car_standby_title" android:key="onigiri_car_standby" android:summary="@string/onigiri_car_standby_summary" settings:controller="moe.foss.onigiri.settings.CarStandbyPreferenceController" />
+        <ListPreference android:title="@string/onigiri_car_standby_hours_title" android:key="onigiri_car_standby_hours" android:persistent="false" android:dependency="onigiri_car_standby" android:entries="@array/onigiri_car_standby_hours_entries" android:entryValues="@array/onigiri_car_standby_hours_values" settings:controller="moe.foss.onigiri.settings.CarStandbyHoursPreferenceController" />
     </SecPreferenceCategory>
     <SecPreferenceCategory android:title="@string/onigiri_ui_settings_title">
         <SecSwitchPreference android:title="@string/onigiri_boot_sound_title" android:key="onigiri_boot_sound" settings:controller="moe.foss.onigiri.settings.BootSoundPreferenceController" />
diff --git a/smali_classes4/moe/foss/onigiri/settings/CarStandbyHoursPreferenceController.smali b/smali_classes4/moe/foss/onigiri/settings/CarStandbyHoursPreferenceController.smali
new file mode 100644
index 0000000..ef03904
--- /dev/null
+++ b/smali_classes4/moe/foss/onigiri/settings/CarStandbyHoursPreferenceController.smali
@@ -0,0 +1,76 @@
+.class public Lmoe/foss/onigiri/settings/CarStandbyHoursPreferenceController;
+.super Lcom/android/settings/core/BasePreferenceController;
+.source "CarStandbyHoursPreferenceController.java"
+
+# interfaces
+.implements Landroidx/preference/Preference$OnPreferenceChangeListener;
+
+
+# How long car standby lasts before it shuts the phone down: persist.sys.onigiri.car_standby_hours,
+# read by onigiri-standby.sh (96 when unset). The row is greyed out while car standby is off.
+
+.method public constructor <init>(Landroid/content/Context;Ljava/lang/String;)V
+    .locals 0
+
+    invoke-direct {p0, p1, p2}, Lcom/android/settings/core/BasePreferenceController;-><init>(Landroid/content/Context;Ljava/lang/String;)V
+    return-void
+.end method
+
+
+# virtual methods
+.method public getAvailabilityStatus()I
+    .locals 0
+
+    const/4 p0, 0x0
+    return p0
+.end method
+
+.method public displayPreference(Landroidx/preference/PreferenceScreen;)V
+    .locals 1
+
+    invoke-super {p0, p1}, Lcom/android/settings/core/BasePreferenceController;->displayPreference(Landroidx/preference/PreferenceScreen;)V
+    invoke-virtual {p0}, Lcom/android/settings/core/BasePreferenceController;->getPreferenceKey()Ljava/lang/String;
+    move-result-object v0
+    invoke-virtual {p1, v0}, Landroidx/preference/PreferenceGroup;->findPreference(Ljava/lang/CharSequence;)Landroidx/preference/Preference;
+    move-result-object p1
+    if-eqz p1, :done
+    invoke-virtual {p1, p0}, Landroidx/preference/Preference;->setOnPreferenceChangeListener(Landroidx/preference/Preference$OnPreferenceChangeListener;)V
+
+    :done
+    return-void
+.end method
+
+# A value set by hand that isn't in the list shows no summary.
+.method public updateState(Landroidx/preference/Preference;)V
+    .locals 2
+
+    check-cast p1, Landroidx/preference/ListPreference;
+    const-string v0, "persist.sys.onigiri.car_standby_hours"
+    const-string v1, "96"
+    invoke-static {v0, v1}, Landroid/os/SemSystemProperties;->get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;
+    move-result-object v0
+    invoke-virtual {p1, v0}, Landroidx/preference/ListPreference;->setValue(Ljava/lang/String;)V
+    invoke-virtual {p1}, Landroidx/preference/ListPreference;->getEntry()Ljava/lang/CharSequence;
+    move-result-object v0
+    invoke-virtual {p1, v0}, Landroidx/preference/ListPreference;->setSummary(Ljava/lang/CharSequence;)V
+    return-void
+.end method
+
+.method public onPreferenceChange(Landroidx/preference/Preference;Ljava/lang/Object;)Z
+    .locals 1
+
+    :try_start
+    check-cast p2, Ljava/lang/String;
+    const-string v0, "persist.sys.onigiri.car_standby_hours"
+    invoke-static {v0, p2}, Landroid/os/SemSystemProperties;->set(Ljava/lang/String;Ljava/lang/String;)V
+    :try_end
+    .catch Ljava/lang/RuntimeException; {:try_start .. :try_end} :failed
+    # Read back, so the row shows what the script will see.
+    invoke-virtual {p0, p1}, Lmoe/foss/onigiri/settings/CarStandbyHoursPreferenceController;->updateState(Landroidx/preference/Preference;)V
+    const/4 p0, 0x1
+    return p0
+
+    :failed
+    const/4 p0, 0x0
+    return p0
+.end method
