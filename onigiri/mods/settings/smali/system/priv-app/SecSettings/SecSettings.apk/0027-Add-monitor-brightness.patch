From: Onigiri
Subject: [PATCH] Add Monitor brightness to Onigiri settings

Display settings gets a Monitor brightness row (shown when the kernel has secdp_ddc_brightness) that
opens its page through RootModSettingsFragment: an Auto switch, the live light and monitor level,
and a Brightness slider drawn like Display > Brightness's (progressBarMode expand) with its level on
the title line. Like the DeX panel's slider, it sets the level with Auto off and teaches Auto with
it on. MonitorBrightnessPreferenceController stores onigiri_monitor_auto, _level and _adjust (the
time, so an unchanged level still counts) in Settings.Global for services.jar's MonitorBrightness
and reads its sys.onigiri.monitor.level and .lux back.

diff --git a/res/layout/onigiri_monitor_readout.xml b/res/layout/onigiri_monitor_readout.xml
new file mode 100644
--- /dev/null
+++ b/res/layout/onigiri_monitor_readout.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Monitor brightness readout: the light Auto works from (title) and the monitor's level (summary). -->
+<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="14dp" android:paddingBottom="14dp"
+  xmlns:android="http://schemas.android.com/apk/res/android">
+    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="16dp">
+        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/onigiri_monitor_light_title" android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="?android:attr/textColorSecondary" />
+        <TextView android:id="@android:id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="?android:attr/textColorPrimary" />
+    </LinearLayout>
+    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?android:attr/listDivider" />
+    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="24dp">
+        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/onigiri_monitor_now_title" android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="?android:attr/textColorSecondary" />
+        <TextView android:id="@android:id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="?android:attr/textColorPrimary" />
+    </LinearLayout>
+</LinearLayout>
diff --git a/res/layout/onigiri_monitor_seekbar.xml b/res/layout/onigiri_monitor_seekbar.xml
new file mode 100644
--- /dev/null
+++ b/res/layout/onigiri_monitor_seekbar.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- A Monitor brightness slider drawn like Display > Brightness (sec_preference_seekbar_brightness),
+     with its level at the end of the title line. -->
+<LinearLayout android:orientation="vertical" android:paddingTop="@dimen/sec_seekbar_preference_item_top_padding" android:paddingBottom="@dimen/sec_seekbar_preference_item_bottom_padding" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/sec_widget_list_with_icon_margin_start" style="@style/list_item_container_style"
+  xmlns:android="http://schemas.android.com/apk/res/android">
+    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/sec_brightness_seekbar_label_bottom_padding">
+        <TextView android:id="@android:id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_alignParentStart="true" android:layout_toStartOf="@android:id/summary" style="@style/list_title_text_style" />
+        <TextView android:id="@android:id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignBaseline="@android:id/title" android:layout_alignParentEnd="true" android:layout_marginEnd="@dimen/sec_widget_list_item_padding_end" android:textAppearance="?android:attr/textAppearanceSmall" />
+    </RelativeLayout>
+    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="@dimen/sec_brightness_seekbar_height">
+        <ImageView android:layout_gravity="center_vertical" android:layout_width="@dimen/sec_brightness_icon_size" android:layout_height="@dimen/sec_brightness_icon_size" android:src="@drawable/sec_ic_settings_brightness_icon" android:contentDescription="@null" />
+        <SeekBar android:layout_gravity="center_vertical" android:id="@android:id/seekbar" android:layout_width="0.0dp" android:layout_height="@dimen/sec_brightness_icon_size" android:layout_weight="1.0" android:paddingStart="@dimen/sec_display_settings_seekbar_with_icon_padding_start" android:paddingEnd="@dimen/sec_display_settings_seekbar_with_icon_padding_end" />
+    </LinearLayout>
+</LinearLayout>
