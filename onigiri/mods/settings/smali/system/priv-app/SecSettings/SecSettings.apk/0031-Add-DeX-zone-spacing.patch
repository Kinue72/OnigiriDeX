From: Onigiri
Subject: [PATCH] Add DeX zone spacing

Zones gets a Space around zones slider (0 to 32 px, persist.sys.onigiri.dex_zone_gap) with the
value on its title line and a picture of snapped windows that follows the slider. The classes are
built from onigiri/mods/settings/java/zones.

diff --git a/res/layout/onigiri_zone_gap_seekbar.xml b/res/layout/onigiri_zone_gap_seekbar.xml
new file mode 100644
index 0000000..78e3ab9
--- /dev/null
+++ b/res/layout/onigiri_zone_gap_seekbar.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Space around zones: the title with the value at its end, a picture of snapped windows (the
+     preference icon, DexZoneGapDemo) and a plain slider. -->
+<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/sec_seekbar_preference_item_top_padding" android:paddingBottom="@dimen/sec_seekbar_preference_item_bottom_padding"
+  xmlns:android="http://schemas.android.com/apk/res/android">
+    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/sec_widget_list_item_padding_start" android:layout_marginEnd="@dimen/sec_widget_list_item_padding_end">
+        <TextView android:id="@android:id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:layout_alignParentStart="true" android:layout_toStartOf="@android:id/summary" style="@style/list_title_text_style" />
+        <TextView android:id="@android:id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignBaseline="@android:id/title" android:layout_alignParentEnd="true" android:textAppearance="?android:attr/textAppearanceSmall" />
+    </RelativeLayout>
+    <ImageView android:id="@android:id/icon" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:layout_marginStart="@dimen/sec_widget_list_item_padding_start" android:layout_marginEnd="@dimen/sec_widget_list_item_padding_end" android:scaleType="fitXY" android:contentDescription="@null" />
+    <SeekBar android:id="@android:id/seekbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/sec_speech_rate_seekbar_height" android:paddingStart="@dimen/sec_seekbar_preference_seekbar_additional_side_padding" android:paddingEnd="@dimen/sec_seekbar_preference_seekbar_additional_side_padding" />
+</LinearLayout>
