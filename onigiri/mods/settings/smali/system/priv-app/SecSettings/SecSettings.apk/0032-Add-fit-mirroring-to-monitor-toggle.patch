     <string name="onigiri_update_local_body">It installs only if it was made for the version you have (%1$s); if not, the phone starts again unchanged. The phone restarts and can\'t be used for about a minute. Your data stays.</string>
+    <string name="onigiri_mirror_fit_title">Fit mirroring to monitor</string>
