From: Onigiri
Subject: [PATCH] Add a default-off toggle that keeps apps in the cover's rotation

The switch stores persist.sys.onigiri.cover_keep_rotation, which services.jar reads to keep
portrait-locked apps such as TikTok and Messenger from turning the cover sideways.

diff --git a/smali_classes4/moe/foss/onigiri/settings/CoverKeepRotationPreferenceController.smali b/smali_classes4/moe/foss/onigiri/settings/CoverKeepRotationPreferenceController.smali
new file mode 100644
--- /dev/null
+++ b/smali_classes4/moe/foss/onigiri/settings/CoverKeepRotationPreferenceController.smali
@@ -0,0 +1,48 @@
+.class public Lmoe/foss/onigiri/settings/CoverKeepRotationPreferenceController;
+.super Lcom/android/settings/core/TogglePreferenceController;
+.source "CoverKeepRotationPreferenceController.java"
+
+.method public constructor <init>(Landroid/content/Context;Ljava/lang/String;)V
+    .locals 0
+    invoke-direct {p0, p1, p2}, Lcom/android/settings/core/TogglePreferenceController;-><init>(Landroid/content/Context;Ljava/lang/String;)V
+    return-void
+.end method
+
+.method public getAvailabilityStatus()I
+    .locals 0
+    const/4 p0, 0x0
+    return p0
+.end method
+
+.method public getSliceHighlightMenuRes()I
+    .locals 0
+    sget p0, Lcom/android/settings/R$string;->menu_key_onigiri_settings:I
+    return p0
+.end method
+
+.method public isChecked()Z
+    .locals 1
+    const-string p0, "persist.sys.onigiri.cover_keep_rotation"
+    const/4 v0, 0x0
+    invoke-static {p0, v0}, Landroid/os/SemSystemProperties;->getBoolean(Ljava/lang/String;Z)Z
+    move-result p0
+    return p0
+.end method
+
+.method public setChecked(Z)Z
+    .locals 1
+    :try_start
+    const-string p0, "persist.sys.onigiri.cover_keep_rotation"
+    invoke-static {p1}, Ljava/lang/Boolean;->toString(Z)Ljava/lang/String;
+    move-result-object v0
+    invoke-static {p0, v0}, Landroid/os/SemSystemProperties;->set(Ljava/lang/String;Ljava/lang/String;)V
+    :try_end
+    .catch Ljava/lang/IllegalArgumentException; {:try_start .. :try_end} :failed
+    .catch Ljava/lang/SecurityException; {:try_start .. :try_end} :failed
+    const/4 p0, 0x1
+    return p0
+    :failed
+    move-exception p0
+    const/4 p0, 0x0
+    return p0
+.end method
diff --git a/res/xml/onigiri_settings.xml b/res/xml/onigiri_settings.xml
--- a/res/xml/onigiri_settings.xml
+++ b/res/xml/onigiri_settings.xml
@@ -24,6 +24,7 @@
     <SecPreferenceCategory android:title="@string/onigiri_ui_settings_title">
         <SecSwitchPreference android:title="@string/onigiri_boot_sound_title" android:key="onigiri_boot_sound" settings:controller="moe.foss.onigiri.settings.BootSoundPreferenceController" />
         <SecSwitchPreference android:title="@string/onigiri_native_blur_title" android:key="onigiri_native_blur" settings:controller="moe.foss.onigiri.settings.LiveBlurPreferenceController" />
+        <SecSwitchPreference android:title="@string/onigiri_cover_keep_rotation_title" android:key="onigiri_cover_keep_rotation" settings:controller="moe.foss.onigiri.settings.CoverKeepRotationPreferenceController" />
     </SecPreferenceCategory>
     <SecPreferenceCategory android:title="@string/onigiri_display_settings_title">
         <SecSwitchPreference android:title="@string/onigiri_max_refresh_rate_title" android:key="onigiri_max_refresh_rate" settings:controller="moe.foss.onigiri.settings.ForceMaxRefreshRatePreferenceController" />
diff --git a/res/values/strings.xml b/res/values/strings.xml
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -15430,4 +15430,5 @@
     <string name="onigiri_rootmod_off_after_restart">%1$s, off after restart</string>
     <string name="onigiri_rootmod_restart_pending">%1$s, restart pending</string>
     <string name="onigiri_rootmod_incompatible">Update Onigiri first to get the newer version.</string>
+    <string name="onigiri_cover_keep_rotation_title">Keep apps in cover rotation</string>
 </resources>
diff --git a/res/values-vi/strings.xml b/res/values-vi/strings.xml
--- a/res/values-vi/strings.xml
+++ b/res/values-vi/strings.xml
@@ -8061,4 +8061,5 @@
     <string name="onigiri_rootmod_off_after_restart">%1$s, tắt sau khi khởi động lại</string>
     <string name="onigiri_rootmod_restart_pending">%1$s, chờ khởi động lại</string>
     <string name="onigiri_rootmod_incompatible">Cập nhật Onigiri trước để có bản mới hơn.</string>
+    <string name="onigiri_cover_keep_rotation_title">Không cho ứng dụng xoay màn hình ngoài</string>
 </resources>
