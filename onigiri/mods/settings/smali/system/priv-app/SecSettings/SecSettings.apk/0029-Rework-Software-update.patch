index 0000000..5a027f5
--- /dev/null
+++ b/res/xml/onigiri_update_settings.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Software update (UpdateSettingsFragment): the release on offer, what's new, then the check,
+     install from storage and notification rows, each its own card with One UI's gap between. The
+     fragment fills them in and pins Download and install under the list. -->
+<PreferenceScreen android:title="@string/onigiri_update_title"
+  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
+    <SecPreferenceCategory android:key="onigiri_update_header_group">
+        <moe.foss.onigiri.update.TextPreference android:key="onigiri_update_header" android:layout="@layout/onigiri_update_header" android:selectable="false" android:persistent="false" />
+    </SecPreferenceCategory>
+    <com.samsung.android.settings.widget.SecInsetCategoryPreference android:key="onigiri_update_notes_gap" settings:removable="false" />
+    <SecPreferenceCategory android:key="onigiri_update_notes_group">
+        <moe.foss.onigiri.update.TextPreference android:title="@string/onigiri_update_whats_new" android:key="onigiri_update_notes" android:layout="@layout/onigiri_update_notes" android:selectable="false" android:persistent="false" />
+    </SecPreferenceCategory>
+    <com.samsung.android.settings.widget.SecInsetCategoryPreference settings:removable="false" />
+    <SecPreferenceCategory android:key="onigiri_update_options">
+        <Preference android:title="@string/onigiri_update_check" android:key="onigiri_update_check" android:persistent="false" />
+        <Preference android:title="@string/onigiri_update_local" android:key="onigiri_update_local" android:persistent="false" />
+        <SecSwitchPreference android:title="@string/onigiri_update_notify" android:key="onigiri_update_notify" android:persistent="false" />
+    </SecPreferenceCategory>
+</PreferenceScreen>
