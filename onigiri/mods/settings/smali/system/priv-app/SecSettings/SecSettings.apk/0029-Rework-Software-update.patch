             <meta-data android:name="com.android.settings.HIGHLIGHT_MENU_KEY" android:value="@string/menu_key_onigiri_settings"/>
         </activity>
+        <receiver android:exported="false" android:name="moe.foss.onigiri.update.UpdateReceiver">
+            <intent-filter>
