     <string name="onigiri_cover_keep_rotation_title">Không cho ứng dụng xoay màn hình ngoài</string>
+    <string name="onigiri_mirror_high_refresh_title">Tần số quét cao khi phản chiếu màn hình</string>
 </resources>
