From: Onigiri
Subject: [PATCH] Add a default-off mirroring high refresh rate toggle

The switch stores persist.sys.onigiri.mirror_high_refresh. With it on, onigiri-mirror shows the
120 Hz inner panel while a monitor mirrors the phone and the phone is open.

diff --git a/smali_classes4/moe/foss/onigiri/settings/MirrorHighRefreshPreferenceController.smali b/smali_classes4/moe/foss/onigiri/settings/MirrorHighRefreshPreferenceController.smali
new file mode 100644
--- /dev/null
+++ b/smali_classes4/moe/foss/onigiri/settings/MirrorHighRefreshPreferenceController.smali
@@ -0,0 +1,48 @@
+.class public Lmoe/foss/onigiri/settings/MirrorHighRefreshPreferenceController;
+.super Lcom/android/settings/core/TogglePreferenceController;
+.source "MirrorHighRefreshPreferenceController.java"
+
+.method public constructor <init>(Landroid/content/Context;Ljava/lang/String;)V
+    .locals 0
+    invoke-direct {p0, p1, p2}, Lcom/android/settings/core/TogglePreferenceController;-><init>(Landroid/content/Context;Ljava/lang/String;)V
+    return-void
+.end method
+
+.method public getAvailabilityStatus()I
+    .locals 0
+    const/4 p0, 0x0
+    return p0
+.end method
+
+.method public getSliceHighlightMenuRes()I
+    .locals 0
+    sget p0, Lcom/android/settings/R$string;->menu_key_onigiri_settings:I
+    return p0
+.end method
+
+.method public isChecked()Z
+    .locals 1
+    const-string p0, "persist.sys.onigiri.mirror_high_refresh"
+    const/4 v0, 0x0
+    invoke-static {p0, v0}, Landroid/os/SemSystemProperties;->getBoolean(Ljava/lang/String;Z)Z
+    move-result p0
+    return p0
+.end method
+
+.method public setChecked(Z)Z
+    .locals 1
+    :try_start
+    const-string p0, "persist.sys.onigiri.mirror_high_refresh"
+    invoke-static {p1}, Ljava/lang/Boolean;->toString(Z)Ljava/lang/String;
+    move-result-object v0
+    invoke-static {p0, v0}, Landroid/os/SemSystemProperties;->set(Ljava/lang/String;Ljava/lang/String;)V
+    :try_end
+    .catch Ljava/lang/IllegalArgumentException; {:try_start .. :try_end} :failed
+    .catch Ljava/lang/SecurityException; {:try_start .. :try_end} :failed
+    const/4 p0, 0x1
+    return p0
+    :failed
+    move-exception p0
+    const/4 p0, 0x0
+    return p0
+.end method
diff --git a/res/xml/onigiri_settings.xml b/res/xml/onigiri_settings.xml
--- a/res/xml/onigiri_settings.xml
+++ b/res/xml/onigiri_settings.xml
@@ -29,6 +29,7 @@
     <SecPreferenceCategory android:title="@string/onigiri_display_settings_title">
         <SecSwitchPreference android:title="@string/onigiri_max_refresh_rate_title" android:key="onigiri_max_refresh_rate" settings:controller="moe.foss.onigiri.settings.ForceMaxRefreshRatePreferenceController" />
         <SecSwitchPreference android:title="@string/onigiri_dex_high_refresh_title" android:key="onigiri_dex_high_refresh" settings:controller="moe.foss.onigiri.settings.DexHighRefreshPreferenceController" />
+        <SecSwitchPreference android:title="@string/onigiri_mirror_high_refresh_title" android:key="onigiri_mirror_high_refresh" settings:controller="moe.foss.onigiri.settings.MirrorHighRefreshPreferenceController" />
         <ListPreference android:title="@string/onigiri_external_mode_title" android:key="onigiri_external_mode" android:persistent="false" settings:controller="moe.foss.onigiri.settings.ExternalDisplayModePreferenceController" />
         <ListPreference android:title="@string/onigiri_external_rotation_title" android:key="onigiri_external_rotation" android:persistent="false" android:entries="@array/onigiri_external_rotation_entries" android:entryValues="@array/onigiri_external_rotation_values" settings:controller="moe.foss.onigiri.settings.ExternalDisplayRotationPreferenceController" />
     </SecPreferenceCategory>
diff --git a/res/values/strings.xml b/res/values/strings.xml
