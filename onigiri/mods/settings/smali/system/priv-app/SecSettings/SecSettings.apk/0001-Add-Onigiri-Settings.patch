         </receiver>
         <service android:exported="true" android:name="androidx.glance.appwidget.GlanceRemoteViewsService" android:permission="android.permission.BIND_REMOTEVIEWS"/>
+        <activity android:exported="true" android:label="@string/onigiri_settings_title" android:name="com.android.settings.Settings$OnigiriSettingsActivity">
