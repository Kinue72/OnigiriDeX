     const-string v0, "onigiri_ss_detection"
 
-    const/4 v1, 0x0
+    const/4 v1, 0x1
 
     invoke-static {p0, v0, v1}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
 
     move-result p0
 
