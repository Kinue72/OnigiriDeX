diff --git a/prebuilts/sm8550-repack.sh b/prebuilts/sm8550-repack.sh
index 4f9f93cfdd90fd17cdff78d2468ab6b70f2c981d..0a489fd5d6931064095bd751277322a8af607a40 100644
--- a/prebuilts/sm8550-repack.sh
+++ b/prebuilts/sm8550-repack.sh
@@ -142,3 +142,26 @@ sm8550_flash_prepared() {
     abort "Flashing $label failed.";
   [ "$isro" != 1 ] || blockdev --setro "$block" 2>/dev/null;
 }
+
+patch_dlkm_fstab() {
+  local fstab="$1" output="$1.tmp";
+
+  [ -f "$fstab" ] || abort "vendor_boot fstab.qcom was not found. Aborting...";
+  awk '
+    BEGIN { OFS = "\t" }
+    $1 == "vendor_dlkm" || $1 == "system_dlkm" {
+      count = split($5, flags, ",")
+      value = ""
+      for (i = 1; i <= count; i++) {
+        if (flags[i] ~ /^avb(=|$)/)
+          continue
+        value = value (value == "" ? "" : ",") flags[i]
+      }
+      $5 = value
+    }
+    { print }
+  ' "$fstab" >"$output" || abort "Failed to patch DLKM AVB flags. Aborting...";
+  cat "$output" >"$fstab" || abort "Failed to write patched fstab.";
+  rm -f "$output" || abort "Failed to remove temporary fstab.";
+}
+
