+static int mdnie_parse_ead(const char *buf, size_t size, u8 rgb[3])
+{
+	size_t pos = 0;
+	int i, value;
+
+	for (i = 0; i < 3; i++) {
+		while (pos < size && isspace(buf[pos]))
+			pos++;
+		if (pos == size || !isdigit(buf[pos]))
+			return -EINVAL;
+
+		value = 0;
+		do {
+			value = value * 10 + buf[pos++] - '0';
+			if (value > 255)
+				return -EINVAL;
+		} while (pos < size && isdigit(buf[pos]));
+
+		if (pos < size && !isspace(buf[pos]))
+			return -EINVAL;
+		rgb[i] = value;
+	}
+
+	while (pos < size && isspace(buf[pos]))
+		pos++;
+
+	return pos == size ? 0 : -EINVAL;
+}
+
+static bool mdnie_ead_supported(struct samsung_display_driver_data *vdd)
+{
+	struct mdnie_lite_tune_data *data;
+
+	if (!vdd || !vdd->mdnie.support_mdnie ||
+		vdd->ndx != SECONDARY_DISPLAY_NDX ||
+		vdd->mdnie.support_trans_dimming)
+		return false;
+
+	data = vdd->mdnie.mdnie_data;
+	if (!data || !data->DSI_RGB_SENSOR_MDNIE ||
+		!data->DSI_RGB_SENSOR_MDNIE_1 ||
+		!data->DSI_RGB_SENSOR_MDNIE_2)
+		return false;
+
+	return data->dsi_bypass_mdnie_size == 6 &&
+		data->mdnie_step_index[MDNIE_STEP1] == 2 &&
+		data->mdnie_step_index[MDNIE_STEP2] == 3 &&
+		data->dsi_scr_step_index == 2 &&
+		data->dsi_rgb_sensor_mdnie_1_size == 88 &&
+		data->dsi_rgb_sensor_mdnie_2_size == 168 &&
+		data->dsi_rgb_sensor_mdnie_3_size == 0 &&
+		data->address_scr_white[ADDRESS_SCR_WHITE_RED_OFFSET] == 22 &&
+		data->address_scr_white[ADDRESS_SCR_WHITE_GREEN_OFFSET] == 23 &&
+		data->address_scr_white[ADDRESS_SCR_WHITE_BLUE_OFFSET] == 24;
+}
+
+static int mdnie_copy_tune_data(struct mdnie_lite_tune_data *data,
+		struct dsi_cmd_desc *source)
+{
+	char *buffers[MDNIE_STEP_MAX] = {
+		data->DSI_RGB_SENSOR_MDNIE_1,
+		data->DSI_RGB_SENSOR_MDNIE_2,
+		data->DSI_RGB_SENSOR_MDNIE_3,
+	};
+	int sizes[MDNIE_STEP_MAX] = {
+		data->dsi_rgb_sensor_mdnie_1_size,
+		data->dsi_rgb_sensor_mdnie_2_size,
+		data->dsi_rgb_sensor_mdnie_3_size,
+	};
+	int i, step;
+
+	if (!source || !data->DSI_RGB_SENSOR_MDNIE)
+		return -EINVAL;
+
+	for (i = 0; i < MDNIE_STEP_MAX; i++) {
+		if (!sizes[i])
+			continue;
+		step = data->mdnie_step_index[i];
+		if (sizes[i] < 0 || !buffers[i] || step < 0 ||
+			step >= data->dsi_bypass_mdnie_size ||
+			!source[step].ss_txbuf ||
+			source[step].msg.tx_len != (size_t)sizes[i] ||
+			data->DSI_RGB_SENSOR_MDNIE[step].msg.tx_len != (size_t)sizes[i] ||
+			data->DSI_RGB_SENSOR_MDNIE[step].ss_txbuf != (u8 *)buffers[i])
+			return -EINVAL;
+	}
+
+	for (i = 0; i < MDNIE_STEP_MAX; i++) {
+		if (!sizes[i])
+			continue;
+		step = data->mdnie_step_index[i];
+		if ((u8 *)buffers[i] != source[step].ss_txbuf)
+			memcpy(buffers[i], source[step].ss_txbuf, sizes[i]);
+	}
+
+	return 0;
+}
+
+static int mdnie_prepare_ead(struct samsung_display_driver_data *vdd,
+		struct dsi_cmd_desc **selected)
+{
+	struct mdnie_lite_tun_type *tune = vdd->mdnie.mdnie_tune_state_dsi;
+	struct mdnie_lite_tune_data *data = vdd->mdnie.mdnie_data;
+	u8 *white;
+	int i, address, ret;
+
+	if (!mdnie_ead_supported(vdd) || !tune || !*selected ||
+		(tune->ead_rgb[0] == 255 && tune->ead_rgb[1] == 255 &&
+		 tune->ead_rgb[2] == 255) ||
+		tune->mdnie_bypass != BYPASS_DISABLE ||
+		tune->mdnie_accessibility != ACCESSIBILITY_OFF ||
+		tune->hdr || tune->night_mode_enable || tune->color_lens_enable ||
+		tune->hmt_color_temperature || tune->light_notification ||
+		ss_is_panel_lpm(vdd) || *selected == data->DSI_BYPASS_MDNIE)
+		return 0;
+
+	ret = mdnie_copy_tune_data(data, *selected);
+	if (ret)
+		return ret;
+
+	white = data->DSI_RGB_SENSOR_MDNIE[data->dsi_scr_step_index].ss_txbuf;
+	for (i = 0; i < ADDRESS_SCR_WHITE_MAX; i++) {
+		address = data->address_scr_white[i];
+		white[address] = (white[address] * tune->ead_rgb[i] + 127) / 255;
+	}
+	*selected = data->DSI_RGB_SENSOR_MDNIE;
+
+	return 0;
+}
