From: Onigiri
Subject: [PATCH] Capture the DeX desktop for the assistant

diff --git a/smali_classes2/com/android/server/wm/WindowManagerService.smali b/smali_classes2/com/android/server/wm/WindowManagerService.smali
index 36c5b48..6cdd56c 100644
--- a/smali_classes2/com/android/server/wm/WindowManagerService.smali
+++ b/smali_classes2/com/android/server/wm/WindowManagerService.smali
@@ -24200,7 +24200,8 @@
     move-result-object v0
 
     :goto_1
-    invoke-virtual {p0, v0}, Lcom/android/server/wm/WindowManagerService;->takeAssistScreenshot(Ljava/util/Set;)Landroid/window/ScreenCapture$ScreenshotHardwareBuffer;
+    # Onigiri: Samsung's assist path (voice assistant, Gemini) captures the DeX desktop while DeX runs.
+    invoke-virtual {p0, v0, v2}, Lcom/android/server/wm/WindowManagerService;->takeAssistScreenshot(Ljava/util/Set;Z)Landroid/window/ScreenCapture$ScreenshotHardwareBuffer;
 
     move-result-object p0
 
@@ -41847,6 +41848,18 @@
 .end method
 
 .method public final takeAssistScreenshot(Ljava/util/Set;)Landroid/window/ScreenCapture$ScreenshotHardwareBuffer;
+    .locals 1
+
+    const/4 v0, 0x0
+
+    invoke-virtual {p0, p1, v0}, Lcom/android/server/wm/WindowManagerService;->takeAssistScreenshot(Ljava/util/Set;Z)Landroid/window/ScreenCapture$ScreenshotHardwareBuffer;
+
+    move-result-object p0
+
+    return-object p0
+.end method
+
+.method public final takeAssistScreenshot(Ljava/util/Set;Z)Landroid/window/ScreenCapture$ScreenshotHardwareBuffer;
     .locals 3
 
     const-string v0, "android.permission.READ_FRAME_BUFFER"
@@ -41872,6 +41885,29 @@
 
     const/4 v1, 0x0
 
+    if-eqz p2, :onigiri_display_chosen
+
+    # Onigiri: the assistant overlay shows on the DeX desktop while DeX runs, so capture that.
+    # Samsung pins DeX to display 2 and keeps it ON only while DeX is active.
+    const/4 v1, 0x2
+
+    invoke-virtual {p0, v1}, Lcom/android/server/wm/RootWindowContainer;->getDisplayContent(I)Lcom/android/server/wm/DisplayContent;
+
+    move-result-object v2
+
+    if-eqz v2, :onigiri_no_dex
+
+    iget-object v2, v2, Lcom/android/server/wm/DisplayContent;->mDisplayInfo:Landroid/view/DisplayInfo;
+
+    iget v2, v2, Landroid/view/DisplayInfo;->state:I
+
+    # Display.STATE_ON
+    if-eq v2, v1, :onigiri_display_chosen
+
+    :onigiri_no_dex
+    const/4 v1, 0x0
+
+    :onigiri_display_chosen
     invoke-virtual {p0, v1}, Lcom/android/server/wm/RootWindowContainer;->getDisplayContent(I)Lcom/android/server/wm/DisplayContent;
 
     move-result-object p0
