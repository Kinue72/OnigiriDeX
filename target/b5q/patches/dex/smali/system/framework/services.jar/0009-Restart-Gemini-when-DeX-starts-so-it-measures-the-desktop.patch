From: Onigiri
Subject: [PATCH] Restart Gemini when DeX starts so it measures the desktop

diff --git a/smali_classes2/com/android/server/voiceinteraction/OnigiriGeminiDexListener.smali b/smali_classes2/com/android/server/voiceinteraction/OnigiriGeminiDexListener.smali
new file mode 100644
index 00000000..f7577578
--- /dev/null
+++ b/smali_classes2/com/android/server/voiceinteraction/OnigiriGeminiDexListener.smali
@@ -0,0 +1,215 @@
+.class public final Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;
+.super Ljava/lang/Object;
+.source "OnigiriGeminiDexListener.java"
+
+# interfaces
+.implements Landroid/hardware/display/DisplayManager$DisplayListener;
+
+
+# Onigiri: Gemini sizes its overlay backdrop once per process, for the screen it first shows on.
+# Started on the cover, its backdrop stays blurry on the DeX desktop, so restart that process
+# (:search, which also runs the Google app and Gemini Live) when DeX starts, unless it is in use;
+# Gemini starts it again on next use and measures the desktop.
+
+# static fields
+.field public static sListener:Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;
+
+
+# instance fields
+.field public mDexOn:Z
+
+
+# direct methods
+.method public constructor <init>()V
+    .locals 0
+
+    invoke-direct {p0}, Ljava/lang/Object;-><init>()V
+
+    return-void
+.end method
+
+.method public static register(Landroid/content/Context;Landroid/os/Handler;)V
+    .locals 3
+
+    sget-object v0, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->sListener:Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;
+
+    if-nez v0, :done
+
+    new-instance v0, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;
+
+    invoke-direct {v0}, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;-><init>()V
+
+    invoke-static {}, Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;->onigiriAssistantDisplayId()I
+
+    move-result v1
+
+    if-eqz v1, :dex_off
+
+    const/4 v1, 0x1
+
+    iput-boolean v1, v0, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->mDexOn:Z
+
+    :dex_off
+    sput-object v0, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->sListener:Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;
+
+    const-class v1, Landroid/hardware/display/DisplayManager;
+
+    invoke-virtual {p0, v1}, Landroid/content/Context;->getSystemService(Ljava/lang/Class;)Ljava/lang/Object;
+
+    move-result-object v1
+
+    check-cast v1, Landroid/hardware/display/DisplayManager;
+
+    invoke-virtual {v1, v0, p1}, Landroid/hardware/display/DisplayManager;->registerDisplayListener(Landroid/hardware/display/DisplayManager$DisplayListener;Landroid/os/Handler;)V
+
+    :done
+    return-void
+.end method
+
+
+.method public static isSearchProcessBusy(I)Z
+    .locals 5
+
+    # In use: a visible activity (Google app, Gemini overlay) or a foreground service (Gemini Live,
+    # screen sharing). Restarting it then would cut the user off; the backdrop waits for next time.
+    const-class v0, Lcom/android/server/wm/ActivityTaskManagerInternal;
+
+    invoke-static {v0}, Lcom/android/server/LocalServices;->getService(Ljava/lang/Class;)Ljava/lang/Object;
+
+    move-result-object v0
+
+    check-cast v0, Lcom/android/server/wm/ActivityTaskManagerService$LocalService;
+
+    iget-object v0, v0, Lcom/android/server/wm/ActivityTaskManagerService$LocalService;->this$0:Lcom/android/server/wm/ActivityTaskManagerService;
+
+    iget-object v1, v0, Lcom/android/server/wm/ActivityTaskManagerService;->mGlobalLock:Lcom/android/server/wm/WindowManagerGlobalLock;
+
+    monitor-enter v1
+
+    :try_start_0
+    const-string v2, "com.google.android.googlequicksearchbox:search"
+
+    invoke-virtual {v0, p0, v2}, Lcom/android/server/wm/ActivityTaskManagerService;->getProcessController(ILjava/lang/String;)Lcom/android/server/wm/WindowProcessController;
+
+    move-result-object v2
+
+    const/4 v3, 0x0
+
+    if-eqz v2, :unlock
+
+    iget-boolean v3, v2, Lcom/android/server/wm/WindowProcessController;->mHasForegroundServices:Z
+
+    if-nez v3, :unlock
+
+    invoke-virtual {v2}, Lcom/android/server/wm/WindowProcessController;->hasActivityInVisibleTask()Z
+
+    move-result v3
+
+    :unlock
+    monitor-exit v1
+    :try_end_0
+    .catchall {:try_start_0 .. :try_end_0} :catchall_0
+
+    return v3
+
+    :catchall_0
+    move-exception v0
+
+    :try_start_1
+    monitor-exit v1
+    :try_end_1
+    .catchall {:try_start_1 .. :try_end_1} :catchall_0
+
+    throw v0
+.end method
+
+
+# virtual methods
+.method public final onDisplayAdded(I)V
+    .locals 0
+
+    invoke-virtual {p0, p1}, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->onDisplayChanged(I)V
+
+    return-void
+.end method
+
+.method public final onDisplayChanged(I)V
+    .locals 6
+
+    # Samsung pins the DeX desktop to display 2.
+    const/4 v0, 0x2
+
+    if-ne p1, v0, :done
+
+    invoke-static {}, Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;->onigiriAssistantDisplayId()I
+
+    move-result v1
+
+    iget-boolean v2, p0, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->mDexOn:Z
+
+    const/4 v3, 0x0
+
+    if-ne v1, v0, :store
+
+    const/4 v3, 0x1
+
+    :store
+    iput-boolean v3, p0, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->mDexOn:Z
+
+    # Only when DeX turns on: a backdrop sized for the DeX desktop is still sharp on the cover.
+    if-eqz v3, :done
+
+    if-nez v2, :done
+
+    const-class v0, Landroid/content/pm/PackageManagerInternal;
+
+    invoke-static {v0}, Lcom/android/server/LocalServices;->getService(Ljava/lang/Class;)Ljava/lang/Object;
+
+    move-result-object v0
+
+    check-cast v0, Landroid/content/pm/PackageManagerInternal;
+
+    const-string v1, "com.google.android.googlequicksearchbox"
+
+    const-wide/16 v2, 0x0
+
+    const/4 v4, 0x0
+
+    invoke-virtual {v0, v1, v2, v3, v4}, Landroid/content/pm/PackageManagerInternal;->getPackageUid(Ljava/lang/String;JI)I
+
+    move-result v1
+
+    if-ltz v1, :done
+
+    invoke-static {v1}, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->isSearchProcessBusy(I)Z
+
+    move-result v2
+
+    if-nez v2, :done
+
+    const-class v0, Landroid/app/ActivityManagerInternal;
+
+    invoke-static {v0}, Lcom/android/server/LocalServices;->getService(Ljava/lang/Class;)Ljava/lang/Object;
+
+    move-result-object v0
+
+    check-cast v0, Lcom/android/server/am/ActivityManagerService$LocalService;
+
+    # The process that shows the Gemini overlay (robin FloatyActivity).
+    const-string v2, "com.google.android.googlequicksearchbox:search"
+
+    const-string v3, "Onigiri: DeX started, Gemini re-measures its overlay"
+
+    invoke-virtual {v0, v2, v1, v3}, Lcom/android/server/am/ActivityManagerService$LocalService;->killProcess(Ljava/lang/String;ILjava/lang/String;)V
+
+    :done
+    return-void
+.end method
+
+.method public final onDisplayRemoved(I)V
+    .locals 0
+
+    invoke-virtual {p0, p1}, Lcom/android/server/voiceinteraction/OnigiriGeminiDexListener;->onDisplayChanged(I)V
+
+    return-void
+.end method
