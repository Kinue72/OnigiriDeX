+    invoke-static {v10, v2, v13}, Lcom/android/server/wm/OnigiriZoneController;->onKey(Lcom/android/server/wm/WindowManagerService;Landroid/view/KeyEvent;I)Z
+
+    move-result v10
+
+    if-eqz v10, :onigiri_stock
+
+    return-wide v19
+
+    :onigiri_stock
     const/16 v10, 0x30
 
     if-eq v4, v10, :cond_c
