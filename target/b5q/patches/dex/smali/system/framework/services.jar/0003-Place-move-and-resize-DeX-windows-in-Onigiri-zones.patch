From: Onigiri
Subject: [PATCH] Place, move and resize DeX windows in Onigiri zones

diff --git a/smali_classes2/com/android/server/policy/PhoneWindowManagerExt.smali b/smali_classes2/com/android/server/policy/PhoneWindowManagerExt.smali
index 5646219..3933b84 100644
--- a/smali_classes2/com/android/server/policy/PhoneWindowManagerExt.smali
+++ b/smali_classes2/com/android/server/policy/PhoneWindowManagerExt.smali
@@ -5328,6 +5328,23 @@
     goto/16 :goto_6
 
     :cond_8
+    # Onigiri zones: Meta+Ctrl+Alt+digit swaps the layout. v15: first press of a Meta
+    # combination that no app asked to get itself.
+    if-eqz v15, :onigiri_stock
+
+    iget-object v10, v0, Lcom/android/server/policy/PhoneWindowManagerExt;->mWindowManagerFuncs:Lcom/android/server/wm/WindowManagerServiceExt;
+
+    iget-object v10, v10, Lcom/android/server/wm/WindowManagerServiceExt;->mService:Lcom/android/server/wm/WindowManagerService;
