+.method public final onigiriFinishIfAssistantMoved()V
+    .locals 4
+
+    invoke-static {}, Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;->onigiriAssistantDisplayId()I
+
+    move-result v0
+
+    iget v1, p0, Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;->mOnigiriTokenDisplayId:I
+
+    if-eq v0, v1, :done
+
+    # Gemini keeps its session while minimized, and its windows can't follow a token moved to
+    # another display. End the session as if its service died (onServiceDisconnected); the next
+    # show starts one on the assistant's current display.
