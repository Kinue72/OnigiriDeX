+.method public final onigiriDisplayForNewWindow(ILandroid/view/WindowManager$LayoutParams;)Lcom/android/server/wm/DisplayContent;
+    .locals 3
+
+    iget-object v0, p2, Landroid/view/WindowManager$LayoutParams;->token:Landroid/os/IBinder;
+
+    if-eqz v0, :default
+
+    # Onigiri: a sub-window (popup, panel) goes on its parent window's display. Its token is the
+    # parent's IWindow rather than a WindowToken, so the lookup below would fall back to the
+    # client's display: the minimized Gemini adds popups to its session window on the DeX desktop
+    # from a context on display 0, which failed with BadTokenException.
+    iget v1, p2, Landroid/view/WindowManager$LayoutParams;->type:I
+
+    # FIRST_SUB_WINDOW
+    const/16 v2, 0x3e8
+
+    if-lt v1, v2, :default
+
+    # LAST_SUB_WINDOW
+    const/16 v2, 0x7cf
+
+    if-gt v1, v2, :default
+
+    iget-object v1, p0, Lcom/android/server/wm/WindowManagerService;->mWindowMap:Ljava/util/HashMap;
+
+    invoke-virtual {v1, v0}, Ljava/util/HashMap;->get(Ljava/lang/Object;)Ljava/lang/Object;
