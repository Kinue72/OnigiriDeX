From: Onigiri
Subject: [PATCH] Keep the minimized Gemini on the DeX desktop

diff --git a/smali_classes2/com/android/server/voiceinteraction/OnigiriSessionDisplayListener.smali b/smali_classes2/com/android/server/voiceinteraction/OnigiriSessionDisplayListener.smali
new file mode 100644
index 00000000..787e93cd
--- /dev/null
+++ b/smali_classes2/com/android/server/voiceinteraction/OnigiriSessionDisplayListener.smali
@@ -0,0 +1,73 @@
+.class public final Lcom/android/server/voiceinteraction/OnigiriSessionDisplayListener;
+.super Ljava/lang/Object;
+.source "OnigiriSessionDisplayListener.java"
+
+# interfaces
+.implements Landroid/hardware/display/DisplayManager$DisplayListener;
+.implements Ljava/lang/Runnable;
+
+
+# Onigiri: ends a voice interaction session whose windows (e.g. the minimized Gemini bubble) are
+# on the wrong screen after DeX starts or ends. Gemini keeps its session while it is minimized,
+# so the display chosen when the session started goes stale.
+
+# instance fields
+.field public final mConnection:Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;
+
+
+# direct methods
+.method public constructor <init>(Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;)V
+    .locals 0
+
+    invoke-direct {p0}, Ljava/lang/Object;-><init>()V
+
+    iput-object p1, p0, Lcom/android/server/voiceinteraction/OnigiriSessionDisplayListener;->mConnection:Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;
+
+    return-void
+.end method
+
+
+# virtual methods
+.method public final onDisplayAdded(I)V
+    .locals 0
+
+    invoke-virtual {p0, p1}, Lcom/android/server/voiceinteraction/OnigiriSessionDisplayListener;->onDisplayChanged(I)V
+
+    return-void
+.end method
+
+.method public final onDisplayChanged(I)V
+    .locals 1
+
+    # Samsung pins the DeX desktop to display 2.
+    const/4 v0, 0x2
+
+    if-ne p1, v0, :done
+
+    iget-object v0, p0, Lcom/android/server/voiceinteraction/OnigiriSessionDisplayListener;->mConnection:Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;
+
+    invoke-virtual {v0}, Lcom/android/server/voiceinteraction/VoiceInteractionSessionConnection;->onigiriFinishIfAssistantMoved()V
+
+    :done
+    return-void
+.end method
+
+.method public final run()V
+    .locals 1
+
+    # Posted once after registering: catches a DeX change between choosing the display and
+    # registering this listener.
+    const/4 v0, 0x2
+
+    invoke-virtual {p0, v0}, Lcom/android/server/voiceinteraction/OnigiriSessionDisplayListener;->onDisplayChanged(I)V
+
+    return-void
+.end method
+
+.method public final onDisplayRemoved(I)V
+    .locals 0
+
+    invoke-virtual {p0, p1}, Lcom/android/server/voiceinteraction/OnigiriSessionDisplayListener;->onDisplayChanged(I)V
+
+    return-void
+.end method
