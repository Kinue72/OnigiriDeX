From: Onigiri
Subject: [PATCH] Add a Monitor brightness slider to the DeX panel

DeX hides its own brightness row on a monitor, which has no backlight of its own.
MonitorBrightnessRow goes under it, drawn like DeX's volume slider. It shows while
sys.onigiri.monitor.level holds a level or "ready" (a monitor is on and hasn't refused DDC/CI), and
writes onigiri_monitor_level, then onigiri_monitor_adjust so an unchanged level still counts:
services.jar's MonitorBrightness sets that level, and with Auto on learns it for the light of the
moment.
diff --git a/res/drawable/onigiri_monitor_sun.xml b/res/drawable/onigiri_monitor_sun.xml
new file mode 100644
--- /dev/null
+++ b/res/drawable/onigiri_monitor_sun.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The Monitor brightness row's sun, drawn like DeX's brightness icon. -->
+<vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24"
+  xmlns:android="http://schemas.android.com/apk/res/android">
+    <path android:strokeColor="@color/animated_brightness_icon_color" android:strokeWidth="2" android:strokeLineCap="round" android:fillColor="#00000000"
+        android:pathData="M12,8a4,4 0,1 1,0 8a4,4 0,1 1,0 -8M12,2.5v2.2M12,19.3v2.2M2.5,12h2.2M19.3,12h2.2M5.3,5.3l1.6,1.6M17.1,17.1l1.6,1.6M5.3,18.7l1.6,-1.6M17.1,6.9l1.6,-1.6" />
+</vector>
diff --git a/res/layout/quick_setting_main.xml b/res/layout/quick_setting_main.xml
--- a/res/layout/quick_setting_main.xml
+++ b/res/layout/quick_setting_main.xml
@@ -15,6 +15,7 @@
                     </LinearLayout>
                     <com.sec.android.dexsystemui.components.qs.ui.QSTilePageIndicator android:gravity="center" android:orientation="horizontal" android:id="@id/layout_dot" android:tag="binding_6" android:layout_width="match_parent" android:layout_height="@dimen/page_indicator_height" android:layout_marginTop="@dimen/page_indicator_margin_top" />
                     <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/quick_settings_brightness_slider" />
+                    <moe.foss.onigiri.dex.MonitorBrightnessRow android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" />
                     <include android:id="@id/privacy_item_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/privacy_container_margin_top" android:layout_marginBottom="@dimen/privacy_container_margin_bottom" layout="@layout/privacy_item_container" />
                 </LinearLayout>
                 <include android:id="@id/brightness_detail" android:visibility="gone" layout="@layout/qs_brightness_details_layout" />
