+++ b/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil.smali
@@ -12,6 +12,144 @@
     return-void
 .end method
 
+.method public static getDexDisplay(Landroid/content/Context;)Landroid/view/Display;
+    .locals 1
+
+    # Onigiri: the DeX desktop's display while DeX runs, else null.
+    invoke-static {p0}, Lcom/samsung/android/app/smartcapture/baseutil/device/DexUtils;->isDesktopModeEnabled(Landroid/content/Context;)Z
+
+    move-result v0
+
+    if-eqz v0, :no_dex
+
+    invoke-static {p0}, Lcom/samsung/android/app/smartcapture/baseutil/device/DexUtils;->getDexDualViewDisplay(Landroid/content/Context;)Landroid/view/Display;
+
+    move-result-object p0
+
+    return-object p0
+
+    :no_dex
+    const/4 p0, 0x0
+
+    return-object p0
+.end method
+
+.method public static getDexDisplayContext(Landroid/content/Context;)Landroid/content/Context;
+    .locals 1
+
+    # Onigiri: the given context moved to the DeX desktop while DeX runs, else unchanged.
+    invoke-static {p0}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil;->getDexDisplay(Landroid/content/Context;)Landroid/view/Display;
+
+    move-result-object v0
+
+    if-eqz v0, :no_dex
+
+    invoke-virtual {p0, v0}, Landroid/content/Context;->createDisplayContext(Landroid/view/Display;)Landroid/content/Context;
+
+    move-result-object p0
