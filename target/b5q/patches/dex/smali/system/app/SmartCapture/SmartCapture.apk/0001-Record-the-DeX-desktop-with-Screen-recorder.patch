Subject: [PATCH] Record the DeX desktop with Screen recorder

In DeX the recorder showed its start dialog on the cover and recorded the cover.
While DeX runs, put its dialog and controls on the DeX desktop instead. Samsung's
MediaProjection then mirrors the DeX display, and the video takes the desktop's
aspect ratio with the short side at the chosen quality.

diff --git a/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderController.smali b/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderController.smali
index 9e04aab4..e8e874f3 100644
--- a/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderController.smali
+++ b/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderController.smali
@@ -303,6 +303,31 @@
 
     iput-object p1, p0, Lcom/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderController;->mScreenRecorderService:Lcom/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderService;
 
+    # Onigiri: in DeX, show the recorder's dialogs and controls on the desktop. Samsung's
+    # MediaProjection then records the display of this context, so DeX is recorded.
+    invoke-virtual {p1}, Landroid/content/Context;->getApplicationContext()Landroid/content/Context;
+
+    move-result-object v3
+
+    const/16 v4, 0x7f6
+
+    invoke-static {v3, v4}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil;->getDexWindowContext(Landroid/content/Context;I)Landroid/content/Context;
+
+    move-result-object v3
+
+    if-eqz v3, :onigiri_no_dex
+
+    new-instance v4, Landroid/view/ContextThemeWrapper;
+
+    sget p1, Lcom/samsung/android/app/smartcapture/screenrecorder/R$style;->AppTheme:I
+
+    invoke-direct {v4, v3, p1}, Landroid/view/ContextThemeWrapper;-><init>(Landroid/content/Context;I)V
+
+    iput-object v4, p0, Lcom/samsung/android/app/smartcapture/screenrecorder/ScreenRecorderController;->mContext:Landroid/content/Context;
+
+    goto :goto_0
+
+    :onigiri_no_dex
     invoke-static {p1}, Lcom/samsung/android/app/smartcapture/baseutil/device/DeviceUtils;->isSubDisplayOn(Landroid/content/Context;)Z
 
     move-result v3
@@ -4496,6 +4521,11 @@
 
     move-result-object v3
 
+    # Onigiri: ask on the DeX desktop, which is what gets recorded.
+    invoke-static {v3}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil;->getDexDisplayContext(Landroid/content/Context;)Landroid/content/Context;
+
+    move-result-object v3
+
     sget v4, Lcom/samsung/android/app/smartcapture/screenrecorder/R$style;->DialogAlertTheme:I
 
     invoke-direct {v1, v3, v4}, Landroid/app/AlertDialog$Builder;-><init>(Landroid/content/Context;I)V
diff --git a/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder.smali b/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder.smali
index c1ada7ee..195e37bd 100644
--- a/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder.smali
+++ b/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder.smali
@@ -499,6 +499,26 @@
 
     invoke-static {v0, v1}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/Log;->i(Ljava/lang/String;Ljava/lang/String;)I
 
+    # Onigiri: in DeX, record the desktop at its own aspect ratio.
+    iget-object v1, p0, Lcom/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder;->mContext:Landroid/content/Context;
+
+    invoke-static {v1, p1}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil;->getDexRecordSize(Landroid/content/Context;Landroid/graphics/Point;)Landroid/graphics/Point;
+
+    move-result-object v1
+
+    if-eqz v1, :onigiri_no_dex
+
+    iget v2, v1, Landroid/graphics/Point;->x:I
+
+    iput v2, p0, Lcom/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder;->mRecordWidth:I
+
+    iget v1, v1, Landroid/graphics/Point;->y:I
+
+    iput v1, p0, Lcom/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder;->mRecordHeight:I
+
+    goto :goto_0
+
+    :onigiri_no_dex
     iget-object v1, p0, Lcom/samsung/android/app/smartcapture/screenrecorder/recorder/ScreenRecorder;->mContext:Landroid/content/Context;
 
     invoke-static {v1}, Lcom/samsung/android/app/smartcapture/baseutil/device/DeviceUtils;->isSubDisplayOn(Landroid/content/Context;)Z
diff --git a/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil.smali b/smali_classes3/com/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil.smali
