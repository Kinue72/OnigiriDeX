+    :no_dex
+    return-object p0
+.end method
+
+.method public static getDexRecordSize(Landroid/content/Context;Landroid/graphics/Point;)Landroid/graphics/Point;
+    .locals 5
+
+    # Onigiri: in DeX, the recording size at the desktop's aspect ratio. The short side is the
+    # quality setting's, or the desktop's if that is smaller. Null outside DeX.
+    invoke-static {p0}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil;->getDexDisplay(Landroid/content/Context;)Landroid/view/Display;
+
+    move-result-object v0
+
+    if-eqz v0, :no_dex
+
+    new-instance v1, Landroid/graphics/Point;
+
+    invoke-direct {v1}, Landroid/graphics/Point;-><init>()V
+
+    invoke-virtual {v0, v1}, Landroid/view/Display;->getRealSize(Landroid/graphics/Point;)V
+
+    iget v2, v1, Landroid/graphics/Point;->y:I
+
+    iget v1, v1, Landroid/graphics/Point;->x:I
+
+    iget v3, p1, Landroid/graphics/Point;->x:I
+
+    iget v4, p1, Landroid/graphics/Point;->y:I
+
+    invoke-static {v3, v4}, Ljava/lang/Math;->min(II)I
+
+    move-result v3
+
+    invoke-static {v1, v2}, Ljava/lang/Math;->min(II)I
+
+    move-result v4
+
+    invoke-static {v3, v4}, Ljava/lang/Math;->min(II)I
+
+    move-result v3
+
+    invoke-static {v1, v2}, Ljava/lang/Math;->max(II)I
+
+    move-result p0
+
+    mul-int/2addr p0, v3
+
+    div-int/2addr p0, v4
+
+    add-int/lit8 p0, p0, 0x1
+
+    and-int/lit8 p0, p0, -0x2
+
+    if-lt v1, v2, :portrait
+
+    new-instance p1, Landroid/graphics/Point;
+
+    invoke-direct {p1, p0, v3}, Landroid/graphics/Point;-><init>(II)V
+
+    return-object p1
+
+    :portrait
+    new-instance p1, Landroid/graphics/Point;
