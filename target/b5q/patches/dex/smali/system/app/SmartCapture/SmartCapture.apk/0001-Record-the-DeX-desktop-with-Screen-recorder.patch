+    # Onigiri: a window context on the DeX desktop while DeX runs, else null.
+    invoke-static {p0}, Lcom/samsung/android/app/smartcapture/screenrecorder/util/ContextUtil;->getDexDisplay(Landroid/content/Context;)Landroid/view/Display;
+
+    move-result-object v0
