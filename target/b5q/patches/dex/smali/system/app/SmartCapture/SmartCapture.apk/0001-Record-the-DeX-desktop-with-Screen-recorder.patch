+    invoke-direct {p1, v3, p0}, Landroid/graphics/Point;-><init>(II)V
+
+    return-object p1
+
+    :no_dex
+    const/4 p1, 0x0
+
+    return-object p1
+.end method
+
+.method public static getDexWindowContext(Landroid/content/Context;I)Landroid/content/Context;
+    .locals 2
