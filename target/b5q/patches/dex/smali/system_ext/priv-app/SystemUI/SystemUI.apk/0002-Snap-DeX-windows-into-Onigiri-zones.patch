+# Zone i of the layout inside frame. Inner right/bottom edges give up `gap` like stock DeX
+# halves do: the freeform outline thickness, so focused windows' outlines don't overlap.
+.method public static zoneRect(Landroid/graphics/Rect;[IIILandroid/graphics/Rect;)V
+    .locals 5
+
+    mul-int/lit8 v0, p2, 0x4
+    add-int/lit8 v0, v0, 0x1
