+# Onigiri zones: snap to the zone nearest the pointer instead of stock halves.
+.method public final onigiriGuide(II)I
+    .locals 8
+
+    iget-object v0, p0, Lcom/android/wm/shell/freeform/DexSnappingGuide;->mVisibleFrame:Landroid/graphics/Rect;
+    iget-object v1, p0, Lcom/android/wm/shell/freeform/DexSnappingGuide;->mSnappingBounds:Landroid/graphics/Rect;
+    iget-object v2, p0, Lcom/android/wm/shell/freeform/DexSnappingGuide;->mSnappingOtherBounds:Landroid/graphics/Rect;
+    iget-object v3, p0, Lcom/android/wm/shell/freeform/DexSnappingGuide;->mView:Lcom/android/wm/shell/freeform/DexSnappingGuideView;
+
+    invoke-static {}, Lcom/android/wm/shell/freeform/OnigiriZones;->layout()[I
+    move-result-object v4
+    if-eqz v4, :stock
+
+    # The top edge keeps maximize while the layout only has two zones.
+    const/4 v5, 0x2
+    if-ne p1, v5, :zone
+    invoke-static {v4}, Lcom/android/wm/shell/freeform/OnigiriZones;->count([I)I
+    move-result v5
+    const/4 v6, 0x3
+    if-lt v5, v6, :stock
+
+    :zone
+    iget v5, p0, Lcom/android/wm/shell/freeform/DexSnappingGuide;->mOnigiriPointerX:I
+    iget v6, p0, Lcom/android/wm/shell/freeform/DexSnappingGuide;->mOnigiriPointerY:I
+    and-int/lit8 v7, p1, 0x1
+    if-eqz v7, :not_left
+    iget v5, v0, Landroid/graphics/Rect;->left:I
+    :not_left
+    and-int/lit8 v7, p1, 0x4
+    if-eqz v7, :not_right
+    iget v5, v0, Landroid/graphics/Rect;->right:I
+    add-int/lit8 v5, v5, -0x1
+    :not_right
+    and-int/lit8 v7, p1, 0x2
+    if-eqz v7, :not_top
+    iget v6, v0, Landroid/graphics/Rect;->top:I
+    :not_top
+    and-int/lit8 v7, p1, 0x8
+    if-eqz v7, :not_bottom
+    iget v6, v0, Landroid/graphics/Rect;->bottom:I
+    add-int/lit8 v6, v6, -0x1
+    :not_bottom
+
+    invoke-static {v0, v4, v5, v6}, Lcom/android/wm/shell/freeform/OnigiriZones;->zoneAt(Landroid/graphics/Rect;[III)I
+    move-result v5
+    invoke-static {v0, v4, v5, p2, v1}, Lcom/android/wm/shell/freeform/OnigiriZones;->zoneRect(Landroid/graphics/Rect;[IIILandroid/graphics/Rect;)V
+
+    # No docking partner, so no Snap Assist: DeX lays those out for halves only.
+    invoke-virtual {v2}, Landroid/graphics/Rect;->setEmpty()V
+
+    # Type 0 makes the guide view use the rect as is; its typed modes assume halves.
+    new-instance v6, Landroid/graphics/Rect;
+    invoke-direct {v6, v1}, Landroid/graphics/Rect;-><init>(Landroid/graphics/Rect;)V
+    iget v7, v3, Lcom/android/wm/shell/freeform/DexSnappingGuideView;->mMargin:I
+    invoke-virtual {v6, v7, v7}, Landroid/graphics/Rect;->inset(II)V
+    const/4 v7, 0x0
+    invoke-virtual {v3, v7, v6}, Lcom/android/wm/shell/freeform/DexSnappingGuideView;->show(ILandroid/graphics/Rect;)V
+
+    # A tag per zone: never a stock snap type, so the guide recomputes as the pointer moves.
+    add-int/lit8 v5, v5, 0x10
+    return v5
+
+    :stock
+    invoke-static {p1, p2, v0, v1, v2}, Lcom/android/wm/shell/freeform/DexSnappingGuide;->calculateGuideSize(IILandroid/graphics/Rect;Landroid/graphics/Rect;Landroid/graphics/Rect;)V
+    invoke-virtual {v3, p1, v1}, Lcom/android/wm/shell/freeform/DexSnappingGuideView;->show(ILandroid/graphics/Rect;)V
+    return p1
+.end method
