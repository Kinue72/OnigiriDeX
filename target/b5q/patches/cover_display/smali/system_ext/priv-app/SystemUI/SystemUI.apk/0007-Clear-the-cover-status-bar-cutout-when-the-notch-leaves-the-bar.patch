From: Onigiri
Subject: [PATCH] Clear the cover status bar cutout when the notch leaves the bar

diff --git a/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenPresenter.smali b/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenPresenter.smali
--- a/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenPresenter.smali
+++ b/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenPresenter.smali
@@ -413,7 +413,8 @@
 
     move-result-object v0
 
-    if-eqz v0, :cond_1
+    # Onigiri: the cover notch only reaches the status bar when rotated. Store a missing cutout
+    # too, or the bar keeps padding for the previous rotation's notch after turning back.
 
     invoke-interface {p1}, Lcom/android/systemui/statusbar/phone/IndicatorGarden;->getGardenWindowInsets()Landroid/view/WindowInsets;
 
