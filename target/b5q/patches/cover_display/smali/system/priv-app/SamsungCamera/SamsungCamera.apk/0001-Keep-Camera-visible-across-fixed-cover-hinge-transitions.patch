-    if-eq p0, v0, :cond_1
-
-    sget-object v0, Lcom/sec/android/app/camera/interfaces/DeviceStateManager$DeviceState;->DUAL_PREVIEW:Lcom/sec/android/app/camera/interfaces/DeviceStateManager$DeviceState;
-
-    if-ne p0, v0, :cond_2
-
-    :cond_1
-    sget-object p0, Lcom/sec/android/app/camera/interfaces/DeviceStateManager$DeviceState;->CLOSE:Lcom/sec/android/app/camera/interfaces/DeviceStateManager$DeviceState;
-
-    if-ne p1, p0, :cond_2
-
-    :goto_0
-    const/4 p0, 0x0
-
-    invoke-interface {v2, p0}, Lcom/sec/android/app/camera/interfaces/CameraContext;->setCameraUiVisibility(Z)V
-
-    :cond_2
+    .locals 0
