+.method public static getScalerFlipMode(I)I
+    .locals 2
+
+    # The pictures' scaler flip for SAVE_AS_FLIPPED p0 on a mirrored cover: the preview's axis
+    # (1 horizontal, 2 vertical), or 0 when it is off. -1 leaves Camera's own choice.
+    sget v0, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->sMirror:I
+
+    if-eqz v0, :cond_1
+
+    const/4 v1, 0x1
+
+    if-ne p0, v1, :cond_0
+
+    rsub-int/lit8 v0, v0, 0x3
+
+    return v0
+
+    :cond_0
+    const/4 v0, 0x0
+
+    return v0
+
+    :cond_1
+    const/4 v0, -0x1
+
+    return v0
+.end method
+
+.method public static getVideoFlip(I)I
+    .locals 2
+
+    # The same for MediaRecorder, which counts the axes like sMirror (stock QuickShot passes 2,
+    # rear cam selfie 1).
+    sget v0, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->sMirror:I
+
+    if-eqz v0, :cond_1
+
+    const/4 v1, 0x1
+
+    if-eq p0, v1, :cond_0
+
+    const/4 v0, 0x0
+
+    :cond_0
+    return v0
+
+    :cond_1
+    const/4 v0, -0x1
+
+    return v0
+.end method
