+    # A mirrored cover preview with "Save selfies as previewed" on.
+    sget v0, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->sMirror:I
+
+    if-eqz v0, :cond_0
+
+    if-eqz p0, :cond_0
+
+    sget-object v0, Lcom/sec/android/app/camera/interfaces/CameraSettings$Key;->SAVE_AS_FLIPPED:Lcom/sec/android/app/camera/interfaces/CameraSettings$Key;
+
+    invoke-interface {p0, v0}, Lcom/sec/android/app/camera/interfaces/CameraSettings;->get(Lcom/sec/android/app/camera/interfaces/CameraSettings$Key;)I
+
+    move-result v0
+
+    const/4 v1, 0x1
+
+    if-ne v0, v1, :cond_0
+
+    return v1
+
+    :cond_0
+    const/4 v0, 0x0
+
+    return v0
+.end method
+
+.method public static adjustSaveOrientation(Lcom/sec/android/app/camera/interfaces/CameraSettings;I)I
+    .locals 2
+
+    # The flip (the sensor's for pictures, MediaRecorder's for videos) lands before a picture or
+    # video is turned upright by p1 degrees. A horizontal flip reads left to right at 0 or 180, a
+    # vertical one at 90 or 270; otherwise it reads top to bottom, and half a turn more makes that
+    # left to right (stock QuickShot and rear cam selfie do the same).
+    invoke-static {p0}, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->isSaveFlipped(Lcom/sec/android/app/camera/interfaces/CameraSettings;)Z
+
+    move-result p0
+
+    if-eqz p0, :cond_1
+
+    rem-int/lit16 v0, p1, 0xb4
+
+    if-nez v0, :cond_0
+
+    const/4 v0, 0x2
+
+    goto :goto_0
+
+    :cond_0
+    const/4 v0, 0x1
+
+    :goto_0
+    sget v1, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->sMirror:I
+
+    if-eq v0, v1, :cond_1
+
+    add-int/lit16 p1, p1, 0xb4
+
+    rem-int/lit16 p1, p1, 0x168
+
+    :cond_1
+    return p1
+.end method
+
+.method public static getMotionPhotoOrientation(Lcom/sec/android/app/camera/interfaces/CameraSettings;I)I
+    .locals 2
+
+    # A Motion photo clip saved as previewed takes the motion photo maker's horizontal flip, not
+    # the picture's, so under a vertical one it needs half a turn more than the picture (p1) to
+    # match it. Stock's processing path adds the same turn for a vertical scaler flip
+    # (ProcessingPhotoMakerBase$4.getJpegOrientation), and rear cam selfie does it here.
+    if-ltz p1, :cond_0
+
+    invoke-static {p0}, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->isSaveFlipped(Lcom/sec/android/app/camera/interfaces/CameraSettings;)Z
+
+    move-result p0
+
+    if-eqz p0, :cond_0
+
+    sget v0, Lcom/sec/android/app/camera/util/OnigiriCoverMirror;->sMirror:I
+
+    const/4 v1, 0x1
+
+    if-ne v0, v1, :cond_0
+
+    add-int/lit16 p1, p1, 0xb4
+
+    rem-int/lit16 p1, p1, 0x168
+
+    :cond_0
+    return p1
+.end method
