Subject: [PATCH] Match status bar rotation heights to the primary cover geometry

diff --git a/smali_classes5/com/android/internal/policy/SystemBarUtils.smali b/smali_classes5/com/android/internal/policy/SystemBarUtils.smali
--- a/smali_classes5/com/android/internal/policy/SystemBarUtils.smali
+++ b/smali_classes5/com/android/internal/policy/SystemBarUtils.smali
@@ -219,6 +219,52 @@
 
     :cond_1
     :goto_0
+    invoke-virtual {p0}, Landroid/content/Context;->getDisplayId()I
+
+    move-result v5
+
+    if-nez v5, :onigiri_status_orientation_ready
+
+    invoke-virtual {v3}, Landroid/content/res/Resources;->getConfiguration()Landroid/content/res/Configuration;
+
+    move-result-object v5
+
+    iget v6, v5, Landroid/content/res/Configuration;->semDisplayDeviceType:I
+
+    const/4 v7, 0x5
+
+    if-ne v6, v7, :onigiri_status_orientation_ready
+
+    new-instance v5, Landroid/view/DisplayInfo;
+
+    invoke-direct {v5}, Landroid/view/DisplayInfo;-><init>()V
+
+    invoke-virtual {v0, v5}, Landroid/view/Display;->getDisplayInfo(Landroid/view/DisplayInfo;)Z
+
+    move-result v6
+
+    if-eqz v6, :onigiri_status_orientation_ready
+
+    invoke-virtual {v5}, Landroid/view/DisplayInfo;->getNaturalWidth()I
+
+    move-result v6
+
+    invoke-virtual {v5}, Landroid/view/DisplayInfo;->getNaturalHeight()I
+
+    move-result v7
+
+    const/4 v4, 0x0
+
+    if-le v6, v7, :onigiri_status_cover_rotation
+
+    const/4 v4, 0x1
+
+    :onigiri_status_cover_rotation
+    and-int/lit8 v5, p1, 0x1
+
+    xor-int/2addr v4, v5
+
+    :onigiri_status_orientation_ready
     invoke-static {v3, v2, v4}, Lcom/android/internal/policy/SystemBarUtils;->getStatusBarHeight(Landroid/content/res/Resources;Landroid/view/DisplayCutout;Z)I
 
     move-result v3
