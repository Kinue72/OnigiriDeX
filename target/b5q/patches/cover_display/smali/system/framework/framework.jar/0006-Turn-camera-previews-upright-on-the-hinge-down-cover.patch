+
 .field private greylist-max-o mHwuiContext:Landroid/view/Surface$HwuiContext;
 
 .field private greylist-max-o mIsAutoRefreshEnabled:Z
@@ -236,6 +238,19 @@
 
     if-eqz p1, :cond_0
 
