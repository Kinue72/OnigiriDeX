+.method private blacklist onigiriTurnCameraPreview()Z
+    .locals 4
+
+    # Onigiri: a camera buffer is upright on a TextureView only at rotation 0,
+    # so apps that leave the transform alone show rotation 180 (the cover held
+    # hinge down) upside down, while SurfaceView previews turn with the
+    # display. Turn a Camera2 preview half a turn at rotation 180 on display 0
+    # unless the app already turned it: its matrix then flips Y or skews, or
+    # the view or a parent is rotated or flipped upside down.
+    const/4 v0, 0x0
+
+    iget-object v1, p0, Landroid/view/TextureView;->mSurface:Landroid/graphics/SurfaceTexture;
+
+    if-eqz v1, :cond_0
+
+    iget-boolean v1, v1, Landroid/graphics/SurfaceTexture;->mOnigiriCameraFed:Z
+
+    if-eqz v1, :cond_0
+
+    invoke-virtual {p0}, Landroid/view/TextureView;->getDisplay()Landroid/view/Display;
+
+    move-result-object v1
+
+    if-eqz v1, :cond_0
+
+    invoke-virtual {v1}, Landroid/view/Display;->getDisplayId()I
+
+    move-result v2
+
+    if-nez v2, :cond_0
+
+    invoke-virtual {v1}, Landroid/view/Display;->getRotation()I
+
+    move-result v2
+
+    const/4 v3, 0x2
+
+    if-ne v2, v3, :cond_0
+
+    const/4 v3, 0x0
+
+    move-object v1, p0
+
+    :goto_onigiri_0
+    invoke-virtual {v1}, Landroid/view/View;->getRotation()F
+
+    move-result v2
+
+    cmpl-float v2, v2, v3
+
+    if-nez v2, :cond_0
+
+    invoke-virtual {v1}, Landroid/view/View;->getScaleY()F
+
+    move-result v2
+
+    cmpl-float v2, v2, v3
+
+    if-lez v2, :cond_0
+
+    invoke-virtual {v1}, Landroid/view/View;->getParent()Landroid/view/ViewParent;
+
+    move-result-object v1
+
+    instance-of v2, v1, Landroid/view/View;
+
+    if-eqz v2, :cond_onigiri_0
+
+    check-cast v1, Landroid/view/View;
+
+    goto :goto_onigiri_0
+
+    :cond_onigiri_0
+    iget-object v1, p0, Landroid/view/TextureView;->mOnigiriValues:[F
+
+    if-nez v1, :cond_1
+
+    const/16 v1, 0x9
+
+    new-array v1, v1, [F
+
+    iput-object v1, p0, Landroid/view/TextureView;->mOnigiriValues:[F
+
+    :cond_1
+    iget-object v2, p0, Landroid/view/TextureView;->mMatrix:Landroid/graphics/Matrix;
+
+    invoke-virtual {v2, v1}, Landroid/graphics/Matrix;->getValues([F)V
+
+    # MSKEW_X
+    const/4 v2, 0x1
+
+    aget v2, v1, v2
+
+    cmpl-float v2, v2, v3
+
+    if-nez v2, :cond_0
+
+    # MSKEW_Y
+    const/4 v2, 0x3
+
+    aget v2, v1, v2
+
+    cmpl-float v2, v2, v3
+
+    if-nez v2, :cond_0
+
+    # MSCALE_Y
+    const/4 v2, 0x4
+
+    aget v2, v1, v2
+
+    cmpl-float v2, v2, v3
+
+    if-lez v2, :cond_0
+
+    const/4 v0, 0x1
+
+    :cond_0
+    return v0
+.end method
