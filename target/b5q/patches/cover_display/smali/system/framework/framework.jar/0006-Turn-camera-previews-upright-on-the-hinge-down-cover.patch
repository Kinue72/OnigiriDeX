+    new-instance v0, Ljava/lang/ref/WeakReference;
+
+    invoke-direct {v0, p1}, Ljava/lang/ref/WeakReference;-><init>(Ljava/lang/Object;)V
+
+    iput-object v0, p0, Landroid/view/Surface;->mOnigiriTexture:Ljava/lang/ref/WeakReference;
+
     invoke-virtual {p1}, Landroid/graphics/SurfaceTexture;->isSingleBuffered()Z
 
     move-result v0
@@ -2177,3 +2192,29 @@
 
     throw v0
 .end method
+
+.method public static blacklist onigiriMarkCameraOutput(Landroid/view/Surface;)V
+    .locals 2
+
+    # Onigiri: a TextureView showing this texture is a camera preview.
+    if-eqz p0, :cond_0
+
+    iget-object v0, p0, Landroid/view/Surface;->mOnigiriTexture:Ljava/lang/ref/WeakReference;
+
+    if-eqz v0, :cond_0
+
+    invoke-virtual {v0}, Ljava/lang/ref/WeakReference;->get()Ljava/lang/Object;
+
+    move-result-object v0
+
+    check-cast v0, Landroid/graphics/SurfaceTexture;
+
+    if-eqz v0, :cond_0
+
+    const/4 v1, 0x1
+
+    iput-boolean v1, v0, Landroid/graphics/SurfaceTexture;->mOnigiriCameraFed:Z
+
+    :cond_0
+    return-void
+.end method
diff --git a/smali_classes4/android/view/TextureView.smali b/smali_classes4/android/view/TextureView.smali
--- a/smali_classes4/android/view/TextureView.smali
