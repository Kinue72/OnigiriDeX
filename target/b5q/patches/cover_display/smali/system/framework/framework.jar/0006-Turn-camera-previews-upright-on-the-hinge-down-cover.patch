@@ -259,6 +284,47 @@
 
     iget-object v1, p0, Landroid/view/TextureView;->mMatrix:Landroid/graphics/Matrix;
 
+    if-eqz v2, :cond_onigiri_1
+
+    # Onigiri: the app's transform plus a half turn about the view's center.
+    iget-object v2, p0, Landroid/view/TextureView;->mOnigiriMatrix:Landroid/graphics/Matrix;
