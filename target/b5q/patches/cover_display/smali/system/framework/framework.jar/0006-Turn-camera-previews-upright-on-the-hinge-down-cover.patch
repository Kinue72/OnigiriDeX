+++ b/smali_classes2/android/hardware/camera2/params/OutputConfiguration.smali
@@ -464,6 +464,8 @@
 
     iput-wide v2, p0, Landroid/hardware/camera2/params/OutputConfiguration;->mUsage:J
 
+    invoke-static {p2}, Landroid/view/Surface;->onigiriMarkCameraOutput(Landroid/view/Surface;)V
+
     return-void
 .end method
 
@@ -1793,6 +1795,8 @@
 
     invoke-virtual {v1, p1}, Ljava/util/ArrayList;->add(Ljava/lang/Object;)Z
 
+    invoke-static {p1}, Landroid/view/Surface;->onigiriMarkCameraOutput(Landroid/view/Surface;)V
+
     return-void
 
     :cond_5
diff --git a/smali_classes4/android/view/Surface.smali b/smali_classes4/android/view/Surface.smali
--- a/smali_classes4/android/view/Surface.smali
+++ b/smali_classes4/android/view/Surface.smali
