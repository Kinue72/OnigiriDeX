From: Onigiri
Subject: [PATCH] Show the inner screen in device state 5 for mirroring

Every device state keeps the inner panel off here. Add one more layout, the
inner panel as the default display with the cover off, and hand it out for
state 5 (CONCURRENT_OUTER_DEFAULT, unused on the cover-only Flip5) while
sys.onigiri.inner_layout is set. onigiri-mirror sets it and requests state 5
while a monitor mirrors the phone, the phone is open and "Mirroring high
refresh rate" is on, so the mirror follows the 120 Hz inner panel instead of
the 60 Hz cover. It clears the property only once the cover is back: if
get() followed the switch itself, turning it off mid-mirror made the way out
look like cover-to-cover and left the inner panel powered.

diff --git a/smali/com/android/server/display/DeviceStateToLayoutMap.smali b/smali/com/android/server/display/DeviceStateToLayoutMap.smali
--- a/smali/com/android/server/display/DeviceStateToLayoutMap.smali
+++ b/smali/com/android/server/display/DeviceStateToLayoutMap.smali
@@ -125,8 +125,28 @@
 .end method
 
 .method public final get(I)Lcom/android/server/display/layout/Layout;
-    .locals 1
+    .locals 2
+
+    # Onigiri: while sys.onigiri.inner_layout is set, state 5 (CONCURRENT_OUTER_DEFAULT, unused on
+    # the cover-only Flip5) shows the inner panel: layout 0x105. onigiri-mirror sets it before it
+    # requests state 5 and clears it once the cover is back, so both ends of a transition agree.
+    const/4 v0, 0x5
+
+    if-ne p1, v0, :onigiri_layout_key
+
+    const-string v0, "sys.onigiri.inner_layout"
+
+    const/4 v1, 0x0
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getBoolean(Ljava/lang/String;Z)Z
+
+    move-result v0
+
+    if-eqz v0, :onigiri_layout_key
 
+    const/16 p1, 0x105
+
+    :onigiri_layout_key
     iget-object v0, p0, Lcom/android/server/display/DeviceStateToLayoutMap;->mLayoutMap:Landroid/util/SparseArray;
 
     invoke-virtual {v0, p1}, Landroid/util/SparseArray;->get(I)Ljava/lang/Object;
@@ -221,8 +241,24 @@
     :onigiri_layout_loop
     const/4 v4, 0x5
 
-    if-gt v3, v4, :onigiri_done
+    if-le v3, v4, :onigiri_make_layout
+
+    # Onigiri: after the device states, one more layout under 0x105: state 5 with the inner panel
+    # as the default display and the cover off (the two panels swapped). get() hands it out for
+    # state 5 while sys.onigiri.inner_layout is set (see get()).
+    const/16 v4, 0x105
+
+    if-ne v3, v4, :onigiri_done
+
+    if-eqz v2, :onigiri_done
+
+    move-object v8, v1
 
+    move-object v1, v2
+
+    move-object v2, v8
+
+    :onigiri_make_layout
     invoke-virtual {p0, v3}, Lcom/android/server/display/DeviceStateToLayoutMap;->createLayout(I)Lcom/android/server/display/layout/Layout;
 
     move-result-object v7
@@ -252,6 +288,12 @@
     :onigiri_layout_next
     add-int/lit8 v3, v3, 0x1
 
+    const/4 v4, 0x6
+
+    if-ne v3, v4, :onigiri_layout_loop
+
+    const/16 v3, 0x105
+
     goto :onigiri_layout_loop
 
     :onigiri_no_cover
